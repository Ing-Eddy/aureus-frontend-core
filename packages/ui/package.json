{
  "name": "@aureus-core/ui",
  "version": "0.0.0",
  "description": "shadcn/ui base layer and custom React components for Aureus projects",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ing-Eddy/aureus-frontend-core.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./shadcn/*": {
      "types": "./dist/shadcn/ui/*.d.ts",
      "default": "./dist/shadcn/ui/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/shadcn/hooks/*.d.ts",
      "default": "./dist/shadcn/hooks/*.js"
    },
    "./lib/utils": {
      "types": "./dist/shadcn/lib/utils.d.ts",
      "default": "./dist/shadcn/lib/utils.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shadcn:add": "shadcn add",
    "shadcn:update": "node scripts/shadcn-update.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aureus-core/tsconfig": "workspace:*",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "homepage": "https://ing-eddy.github.io/aureus-frontend-core/",
  "bugs": {
    "url": "https://github.com/Ing-Eddy/aureus-frontend-core/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "ui",
    "components",
    "radix-ui",
    "design-system"
  ]
}
