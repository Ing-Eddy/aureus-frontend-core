{
  "name": "@aureus-core/ui",
  "version": "0.0.0",
  "description": "shadcn/ui base layer and custom React components for Aureus projects",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ing-Eddy/aureus-frontend-core.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./shadcn/*": {
      "types": "./dist/shadcn/ui/*.d.ts",
      "default": "./dist/shadcn/ui/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/shadcn/hooks/*.d.ts",
      "default": "./dist/shadcn/hooks/*.js"
    },
    "./lib/utils": {
      "types": "./dist/shadcn/lib/utils.d.ts",
      "default": "./dist/shadcn/lib/utils.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shadcn:add": "shadcn add",
    "shadcn:update": "node scripts/shadcn-update.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@aureus-core/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  }
}
